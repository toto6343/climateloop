# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 단, 예시 파일은 커밋한다. 이 파일이 없으면 새 환경에서 NEXT_PUBLIC_API_URL 을
# 알 수 없어 앱이 로드되지 않는다.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
