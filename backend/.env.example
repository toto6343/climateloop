# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env

# Gemini API 키
# Google AI Studio(https://aistudio.google.com/apikey)에서 발급합니다.
# 없거나 잘못돼도 서버는 정상 기동하며, AI 해설 대신 계산 결과 기반 요약 문구가 표시됩니다.
GEMINI_API_KEY=your_gemini_api_key_here

# AI 호출 전면 비활성화 (선택)
# 1 / true / yes 중 하나를 넣으면 Gemini를 호출하지 않습니다.
# 오프라인 데모나 API 쿼터 절약이 필요할 때 사용합니다. 테스트는 항상 이 모드로 실행됩니다.
# CLIMATELOOP_DISABLE_AI=1

# CORS 허용 오리진 (선택)
# 미지정 시 localhost / 127.0.0.1 의 3000·3001 포트를 허용합니다.
# 프론트를 다른 포트나 도메인에서 띄운다면 쉼표로 구분해 지정하세요.
# CLIMATELOOP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
