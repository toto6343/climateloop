# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env

# OpenRouter API 키 — 이 프로젝트의 유일한 AI 키입니다.
# 화면 요약(자동 생성 해설)과 "AI 어시스턴트" 채팅(POST /chat) 둘 다 이 키를 씁니다.
# https://openrouter.ai/keys 에서 발급합니다.
#
# 이 키는 백엔드 프로세스 안에서만 읽습니다. 프론트엔드(NEXT_PUBLIC_*)에는
# 절대 넣지 마세요 — 브라우저 번들에 그대로 실려 공개됩니다.
#
# 없어도 서버는 정상 기동합니다. 요약은 계산 결과 기반 폴백 문구로 조용히
# 대체되고, 채팅만 503으로 재시도를 안내합니다.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 사용할 모델 (선택). 미지정 시 google/gemini-2.5-flash-lite
# 요약과 채팅이 같은 모델을 씁니다.
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# AI 호출 전면 비활성화 (선택)
# 1 / true / yes 중 하나를 넣으면 OpenRouter를 호출하지 않습니다 (요약·채팅 모두).
# 오프라인 데모나 API 쿼터 절약이 필요할 때 사용합니다. 테스트는 항상 이 모드로 실행됩니다.
# CLIMATELOOP_DISABLE_AI=1

# CORS 허용 오리진 (선택, 단 배포 시에는 사실상 필수)
# 미지정 시 localhost / 127.0.0.1 의 3000·3001 포트를 허용합니다.
# 프론트를 다른 포트나 도메인에서 띄운다면 쉼표로 구분해 지정하세요.
#
# 외부 도메인(Vercel 등)에 프론트를 올렸다면 반드시 지정해야 합니다. 없으면
# 프리플라이트가 400 으로 떨어지고 브라우저에는 원인을 알 수 없는
# "TypeError: Failed to fetch" 만 남습니다. 끝에 슬래시를 붙이지 마세요 —
# 브라우저가 보내는 Origin 헤더에는 경로도 슬래시도 없어 문자열이 어긋납니다.
# CLIMATELOOP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# CLIMATELOOP_ALLOWED_ORIGINS=https://climateloop.vercel.app

# CORS 허용 오리진 — 정규식 (선택)
# 위 목록으로 잡을 수 없는 경우에만 씁니다. Vercel 프리뷰 배포는 커밋마다
# 도메인이 새로 생기므로(climateloop-git-<브랜치>-<팀>.vercel.app) 목록으로는
# 열거할 수 없습니다. 전체 일치(fullmatch)로 검사합니다.
#
# [주의] 도메인 끝을 반드시 고정하세요. https://climateloop.*\.vercel\.app 처럼
#        열어 두면 남의 프로젝트 도메인도 통과합니다.
# CLIMATELOOP_ALLOWED_ORIGIN_REGEX=https://climateloop-[a-z0-9-]+\.vercel\.app

# ---------------------------------------------------------------------------
# 외부 공공데이터 (선택) — 없으면 지금까지와 똑같이 로컬 추정값으로 동작합니다.
#
# 아래 키가 없거나 자리표시자(your_...)를 그대로 두면 외부 호출을 아예 시도하지
# 않고 조용히 폴백합니다. 서버 기동·화면 동작에는 영향이 없습니다.
# ---------------------------------------------------------------------------

# 공공데이터포털(data.go.kr) 인증키 (Decoding 키) — apihub.kma.go.kr 키와는 다릅니다.
#   - 기상청_단기예보 조회서비스 (초단기실황 getUltraSrtNcst)
#   - 기상청_기상특보 조회서비스 (getWthrWrnList)
# 위 두 서비스를 https://www.data.go.kr 에서 각각 활용신청(개발계정 자동승인)한 뒤
# 마이페이지의 일반 인증키(Decoding)를 넣으세요. 같은 계정이면 두 서비스 모두
# 인증키 값이 동일합니다.
#
# 설정되면 GET /api/weather/scenario 가 현재 실황·특보로 4종 시나리오 중 하나를
# 추천하고, 화면에 "기상청 실시간 데이터 기준: ..." 배지가 뜹니다. 기후 탭 선택을
# 자동으로 바꾸지는 않습니다 — 사용자 선택이 항상 우선입니다.
# (인증키는 아래 PUBLIC_DATA_API_KEY 하나로 통합되었습니다)

# 한국전력거래소(KPX) 공공데이터포털 인증키 (Decoding 키)
#   - 발전원별 발전량 현황조회(GW)
#   - 전력시장 발전설비 정보
#
# 설정되면 POST /regions 의 발전원 구성비가 KPX 실시간 발전량을 반영하고
# (data_source="live"), seed_db.py 가 지역 계수를 KPX 설비용량에서 유도합니다.
# 절대 크기(MWh)는 여전히 추정값입니다 — services/kpx_api.py 상단 주석 참고.
# 공공데이터포털 인증키 — 세 연동(기상청·KPX·에너지공단)이 공유합니다.
#
# 포털 인증키는 **계정 단위**입니다. 서비스마다 활용신청은 따로 해야 하지만
# 발급되는 키 값은 같으므로, 이름도 하나로 둡니다.
#
# Encoding 키(%2B·%3D 가 들어 있는 형태)를 그대로 붙여도 됩니다 —
# service_key() 가 디코딩해서 넘깁니다. Decoding 키를 넣어도 그대로 동작합니다.
#
# [주의] 활용신청이 승인되지 않은 서비스는 키가 유효해도
#        HTTP 400 NO_OPENAPI_SERVICE_ERROR(code 12) 를 돌려줍니다.
#        키 자체가 거부되면 HTTP 403 ...NOT_REGISTERED(code 30) 입니다.
#        두 코드가 가리키는 곳이 다르므로 로그에서 구분하세요.
# PUBLIC_DATA_API_KEY=your_public_data_portal_key_here

# 상세기능 URL (선택).
#
# 공공데이터포털은 같은 서비스의 요청주소가 신청 시점·버전에 따라 다르게
# 안내됩니다(VilageFcstInfoService 와 _2.0 이 함께 살아 있던 기간이 있습니다).
# 아래 기본값으로 404 가 나면, **신청 페이지의 "요청주소"를 그대로 복사해**
# 넣으세요. 경로가 틀려도 폴백하므로 화면은 깨지지 않고 서버 로그에만 남습니다.
# KMA_NCST_URL=http://apis.data.go.kr/1360000/VilageFcstInfoService_2.0/getUltraSrtNcst
# KMA_WARNING_URL=http://apis.data.go.kr/1360000/WthrWrnInfoService/getWthrWrnList
# KPX_GENERATION_URL=http://apis.data.go.kr/B552115/PwrAmountByGenSrc/getPwrAmountByGenSrc
# KPX_CAPACITY_URL=http://apis.data.go.kr/B552115/PowerMarketGenInfo/getPowerMarketGenInfo

# 외부 API 캐시·타임아웃 (선택)
# 해커톤 현장 네트워크를 고려한 기본값입니다 (README 13장 리스크).
#   CACHE_TTL     성공 응답 재사용 시간(초). 기본 480 = 8분 (요구 범위 5~10분)
#   FAILURE_TTL   실패 후 재시도까지의 간격(초). 기본 60
#                 상류가 죽었을 때 매 요청이 타임아웃을 기다리지 않게 합니다.
#   TIMEOUT       상류 응답 대기 상한(초). 기본 6
#
# [주의] README 13장은 "KPX 개발계정은 일 100건 제한"을 적어 두었습니다. 8분 캐싱은
#        24시간 연속으로 호출될 경우 이론상 180건/일이 되어 이 한도를 넘습니다.
#        실제로는 사용자가 화면을 열 때만 호출되므로(연속 폴링이 아님) 데모 중
#        수십 건에 머무를 것으로 보이지만, 하루 종일 띄워 두는 전시 부스처럼
#        상시 접속이 있는 환경이라면 900(15분) 이상으로 올리세요. 한도를 넘기면
#        상류가 거부하고 자동으로 로컬 추정값으로 폴백합니다 — 화면은 깨지지 않고
#        각주가 "추정 시뮬레이션값"으로 돌아갑니다.
# CLIMATELOOP_EXTERNAL_CACHE_TTL=480
# CLIMATELOOP_EXTERNAL_FAILURE_TTL=60
# CLIMATELOOP_EXTERNAL_TIMEOUT=6
